/* pages/submit/submit.wxss */

.submit-page {
  padding-bottom: 160rpx;
  min-height: 100vh;
}

/* 顶部标题 */
.submit-header {
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  padding: 60rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.picker-arrow {
  font-size: 20rpx;
  color: #c0c4cc;
  margin-left: auto;
}

.form-picker.disabled {
  color: #c0c4cc;
  background: #f5f7fa;
}

/* 上传区域 */
.upload-area {
  width: 100%;
  height: 320rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  border: 2rpx dashed #dcdfe6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-area:active {
  border-color: #409EFF;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #606266;
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #c0c4cc;
}

/* 提交按钮 */
.submit-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}