/* pages/home/home.wxss */

.home-page {
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  padding: 48rpx 32rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(64, 158, 255, 0.25);
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.user-detail {
  margin-left: 28rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 数据统计 */
.stats-section {
  padding: 0 24rpx;
  margin-top: -40rpx;
}

.stat-row {
  display: flex;
  gap: 24rpx;
}

.stat-row .stat-card {
  flex: 1;
}

/* 快捷入口 */
.quick-section {
  padding: 32rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.quick-item {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.quick-item:active {
  transform: scale(0.96);
}

.quick-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.icon-score {
  background: linear-gradient(135deg, #e1f3d8 0%, #b3e19d 100%);
}

.icon-submit {
  background: linear-gradient(135deg, #daecff 0%, #a0cfff 100%);
}

.icon-event {
  background: linear-gradient(135deg, #faecd8 0%, #f3d19e 100%);
}

.icon-plan {
  background: linear-gradient(135deg, #e9e1f8 0%, #c7b3ed 100%);
}

.quick-label {
  font-size: 28rpx;
  color: #606266;
  font-weight: 500;
}

/* 提示卡片 */
.tips-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.tips-item {
  font-size: 26rpx;
  color: #909399;
  line-height: 1.8;
}