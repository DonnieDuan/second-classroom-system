/* pages/profile/profile.wxss */

.profile-page {
  padding-bottom: 60rpx;
}

/* 用户信息区域 */
.profile-header {
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  padding: 60rpx 32rpx 80rpx;
  display: flex;
  align-items: center;
  border-radius: 0 0 40rpx 40rpx;
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  border: 4rpx solid #fff;
}

.user-info {
  flex: 1;
  margin-left: 28rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.user-role {
  display: inline-block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-top: 12rpx;
}

.edit-btn {
  font-size: 26rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

/* 详细信息卡片 */
.info-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.info-list {
  background: #f9fafc;
  border-radius: 16rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #ebeef5;
}

.info-row.last {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #606266;
}

.row-value {
  font-size: 28rpx;
  color: #303133;
  font-weight: 500;
}

/* 功能列表 */
.menu-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 24rpx;
}

.menu-list {
  background: #f9fafc;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #ebeef5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f0f2f5;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
}

.menu-arrow {
  font-size: 36rpx;
  color: #c0c4cc;
}

/* 退出登录 */
.logout-section {
  padding: 24rpx;
  margin-top: 20rpx;
}

.logout-btn {
  background: #fff;
  color: #f56c6c;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.logout-btn::after {
  border: none;
}