<!--pages/profile/profile.wxml-->
<view class="profile-page">
  <!-- 用户信息区域 -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill" class="avatar" />
      <view wx:else class="avatar-placeholder">👤</view>
    </view>
    <view class="user-info">
      <view class="user-name">{{userInfo.name || '同学'}}</view>
      <view class="user-role">{{userInfo.role === 'student' ? '学生' : '其他'}}</view>
    </view>
    <view class="edit-btn">编辑</view>
  </view>

  <!-- 详细信息卡片 -->
  <view class="info-card">
    <view class="info-title">个人信息</view>
    <view class="info-list">
      <view class="info-row">
        <text class="row-label">姓名</text>
        <text class="row-value">{{userInfo.name || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">学号</text>
        <text class="row-value">{{userInfo.studentNo || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">班级</text>
        <text class="row-value">{{userInfo.className || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">专业</text>
        <text class="row-value">{{userInfo.major || '--'}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">学院</text>
        <text class="row-value">{{userInfo.college || '--'}}</text>
      </view>
      <view class="info-row last">
        <text class="row-label">角色</text>
        <text class="row-value">{{userInfo.role === 'student' ? '学生' : '--'}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-card">
    <view class="menu-title">功能</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goScores">
        <view class="menu-icon icon-score">📊</view>
        <view class="menu-label">我的成绩</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="goSubmit">
        <view class="menu-icon icon-submit">📝</view>
        <view class="menu-label">成绩填报</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="goEvents">
        <view class="menu-icon icon-event">🏆</view>
        <view class="menu-label">赛事列表</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="goPlan">
        <view class="menu-icon icon-plan">📅</view>
        <view class="menu-label">学习计划</view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="goSettings">
        <view class="menu-icon icon-setting">⚙️</view>
        <view class="menu-label">设置</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="doLogout">退出登录</button>
  </view>
</view>