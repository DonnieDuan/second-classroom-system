/* pages/plan/plan.wxss */

.plan-page {
  padding-bottom: 40rpx;
}

/* 顶部 */
.plan-header {
  background: linear-gradient(135deg, #409EFF 0%, #66b1ff 100%);
  padding: 60rpx 32rpx 50rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #fff;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-left: -64rpx;
}

.header-placeholder {
  width: 64rpx;
}

/* 进度卡片 */
.progress-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.progress-percent {
  font-size: 36rpx;
  font-weight: bold;
  color: #409EFF;
}

.progress-bar {
  height: 16rpx;
  background: #ebeef5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #409EFF 0%, #66b1ff 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-info {
  display: flex;
  align-items: center;
}

.progress-item {
  flex: 1;
  text-align: center;
}

.item-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #303133;
}

.item-label {
  display: block;
  font-size: 24rpx;
  color: #909399;
  margin-top: 4rpx;
}

.progress-divider {
  width: 1rpx;
  height: 60rpx;
  background: #ebeef5;
}

/* 统计数据卡片 */
.stats-card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 28rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stats-item {
  width: 25%;
  text-align: center;
}

.stats-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.stats-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #409EFF;
}

.stats-label {
  font-size: 24rpx;
  color: #909399;
  margin-top: 4rpx;
}

/* 计划列表 */
.plan-section {
  margin: 0 24rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 20rpx;
}

.plan-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.plan-status {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.plan-status.ongoing {
  background: #409EFF;
  box-shadow: 0 0 0 6rpx rgba(64, 158, 255, 0.2);
}

.plan-status.done {
  background: #67c23a;
}

.plan-info {
  flex: 1;
  overflow: hidden;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #303133;
  margin-bottom: 6rpx;
}

.plan-item.completed .plan-name {
  color: #909399;
  text-decoration: line-through;
}

.plan-desc {
  font-size: 24rpx;
  color: #909399;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-action {
  font-size: 26rpx;
  color: #409EFF;
  padding: 8rpx 20rpx;
  border: 1rpx solid #b3d8ff;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.plan-item.completed .plan-action {
  color: #909399;
  border-color: #dcdfe6;
}

.empty-hint {
  text-align: center;
  font-size: 26rpx;
  color: #909399;
  padding: 40rpx 0;
}