/* pages/login/login.wxss */

page {
  background: linear-gradient(180deg, #409EFF 0%, #66b1ff 50%, #f0f2f5 100%);
  min-height: 100vh;
}

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 60rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.login-logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 12rpx;
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}

.error-msg {
  color: #f56c6c;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  background: #fef0f0;
  border-radius: 12rpx;
}

.login-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  letter-spacing: 8rpx;
}

.login-footer {
  margin-top: auto;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}